# ========================
# NN Auth System — .gitignore
# ========================

# ────────────────────────────
# 🐍 Python / Backend
# ────────────────────────────

# Entorno virtual — NUNCA versionar
be/.venv/
.venv/
venv/
env/

# Cache de Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribución / empaquetado
*.egg-info/
dist/
build/
*.egg

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# ────────────────────────────
# ⚛️ Node.js / Frontend
# ────────────────────────────

# Dependencias — se reinstalan con pnpm install
node_modules/

# Build de producción
fe/dist/

# Cache de Vite
fe/.vite/

# Vitest
fe/coverage/

# ────────────────────────────
# 🔐 Variables de entorno y datos sensibles
# ────────────────────────────
# NUNCA versionar archivos .env con credenciales reales ni volcados de base de datos
.env
*.env
*.env.local
.env.*.local
be/users_dump.txt
users_dump.txt
alembic_output.txt
be/alembic_output.txt

# Sí versionar los .env.example (plantillas sin datos reales)
!.env.example
!*.env.example

# ────────────────────────────
# 🖥️ IDEs y Editores
# ────────────────────────────
# .vscode/settings.json → SÍ se versiona (config compartida del proyecto)
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ────────────────────────────
# 📦 Docker
# ────────────────────────────
# No ignorar docker-compose.yml (sí se versiona)
# Ignorar volúmenes locales si existieran
docker-volumes/

# ────────────────────────────
# 📄 Otros
# ────────────────────────────
*.log
*.tmp
*.bak
*.db
*.sqlite

# ────────────────────────────
# 🎓 Estándar taller SENA
# ────────────────────────────
.env.local
*.key
.expo/
*.apk
