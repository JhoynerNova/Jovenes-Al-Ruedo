# Base de datos PostgreSQL
POSTGRES_USER=jar_user
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=jovenes_al_ruedo
DATABASE_URL=postgresql://jar_user:change_this_password_in_production@db:5432/jovenes_al_ruedo

# Seguridad JWT
SECRET_KEY=change_this_secret_key_to_a_minimum_32_characters_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Servidor de Correo (SMTP)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@jovenes-al-ruedo.com
MAIL_PASSWORD=change_this_mail_password
MAIL_FROM=noreply@jovenes-al-ruedo.com
MAIL_FROM_NAME=Jovenes al Ruedo

# Frontend y CORS
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
ENVIRONMENT=development
